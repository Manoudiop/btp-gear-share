# Projet Supabase. Copiez ce fichier en .env.local et renseignez vos clés :
#   Supabase → Project Settings → API
#
# Sans ces variables, l'application tourne sur les données de démonstration
# de src/data/ : aucun compte n'est nécessaire pour lancer le projet.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
